PORT=4000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string-in-production
CLIENT_ORIGIN=http://localhost:5173
# 'none' if the client is deployed on a different site than this API (see
# server/.env.production) — cross-site cookies require SameSite=None.
COOKIE_SAME_SITE=lax
COMMENT_MONTHLY_LIMIT=100
DATA_DIR=./data
