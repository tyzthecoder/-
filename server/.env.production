# Template for the API's production environment. This is NOT meant to run
# as a Vercel serverless function: better-sqlite3 needs a writable,
# persistent local disk (Vercel's filesystem is read-only/ephemeral per
# invocation) and Socket.IO needs long-lived connections (serverless
# functions don't hold those open). Deploy this half on a normal Node
# process instead — Render, Railway, Fly.io, a plain VM, etc. — and point
# the Vercel-hosted client at it via client/.env.production's VITE_API_URL.
#
# Fill in real values and set these on whatever host actually runs this
# server; don't commit a copy of this file with real secrets filled in.

NODE_ENV=production
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value-you-generate-at-deploy-time

# Must match the exact origin the client is served from (no trailing slash).
CLIENT_ORIGIN=https://your-app.vercel.app

# 'lax' only works if client + API end up same-site. Deploying the client on
# Vercel and this API elsewhere is cross-site, so set this to 'none' in that
# case (forces the session cookie's Secure flag on too — see config.js).
COOKIE_SAME_SITE=none

COMMENT_MONTHLY_LIMIT=100

# Where the SQLite database + session store files are written. Point this at
# a persistent volume/disk on your host — an ephemeral filesystem (most
# serverless/container platforms without a mounted volume) will silently
# lose all data on every redeploy or restart.
DATA_DIR=/var/data/unknown-signal
