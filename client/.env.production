# Loaded automatically by Vite (`vite build` runs in "production" mode) and
# by Vercel's build step for this project. These are baked into the static
# bundle at build time — do not put secrets here, everything in a VITE_
# variable ends up readable in the shipped JS.
#
# Fill in the real deployed origin of the API server (see server/.env.production
# for its config) before deploying. The server is NOT deployed by this file —
# better-sqlite3's on-disk database and Socket.IO's long-lived connections
# don't fit Vercel's serverless model, so run server/ on a normal Node host
# (Render, Railway, Fly.io, a VM, etc.) and point these at it.

# Origin of the deployed API (no trailing slash), e.g. https://unknown-signal-api.onrender.com
VITE_API_URL=https://your-api-host.example.com

# Usually the same origin as the API — Socket.IO shares it unless you've
# split websocket traffic onto its own host. Only set this if it differs
# from VITE_API_URL above.
# VITE_SOCKET_URL=https://your-api-host.example.com
